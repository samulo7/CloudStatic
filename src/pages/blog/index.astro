---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'CloudStatic Blog';
const description = 'Static blog articles rendered at build time.';
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title={title} description={description}>
  <h1>{title}</h1>
  <p>{description}</p>

  {
    posts.length === 0 ? (
      <p>No posts yet.</p>
    ) : (
      <ul>
        {posts.map((post) => (
          <li>
            <article>
              <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
              <p>{post.data.description}</p>
              <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('zh-CN')}</time>
              <ul>
                {post.data.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </article>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
