---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'CloudStatic';
const description = 'Image hosting and static blog platform built for Cloudflare Workers Static Assets.';
---

<BaseLayout title={title} description={description}>
  <h1>{title}</h1>
  <p>{description}</p>
  <p>Build Time Heavy, Runtime Zero.</p>
  <p><a href="/blog/">Read the blog</a></p>
</BaseLayout>
