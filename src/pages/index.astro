---
import '../styles/global.css';

const title = 'CloudStatic';
const description = 'Image hosting and static blog platform built for Cloudflare Workers Static Assets.';
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p>{description}</p>
      <p>Build Time Heavy, Runtime Zero.</p>
    </main>
  </body>
</html>
